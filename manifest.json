{
    "name": "Auto Swiper",
    "version": "3.0",
    "description": "Automate swiping on Tinder and Bumble with smart filters, analytics, and more.",
    "manifest_version": 3,
    "permissions": [
        "storage",
        "tabs",
        "debugger",
        "notifications"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "images/icon16.png",
            "32": "images/icon32.png",
            "48": "images/icon48.png",
            "128": "images/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.tinder.com/*",
                "*://*.tinder.com/*",
                "https://bumble.com/*",
                "*://*.bumble.com/*"
            ],
            "js": [
                "storage.js",
                "content.js"
            ]
        }
    ],
    "host_permissions": [
        "https://www.tinder.com/*",
        "*://*.tinder.com/*",
        "https://bumble.com/*",
        "*://*.bumble.com/*"
    ],
    "web_accessible_resources": [
        {
            "resources": ["sounds/*"],
            "matches": ["https://www.tinder.com/*", "*://*.tinder.com/*", "https://bumble.com/*", "*://*.bumble.com/*"]
        }
    ]
}
